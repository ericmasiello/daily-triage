#!/bin/bash
# Mock glab CLI for integration tests.
# Returns fixture JSON based on MOCK_FIXTURE_DIR and MOCK_FIXTURE_SET env vars.

FIXTURE_DIR="${MOCK_FIXTURE_DIR:?MOCK_FIXTURE_DIR must be set}"
FIXTURE_SET="${MOCK_FIXTURE_SET:-default}"

# Simulate auth failure when requested
if [[ "${MOCK_GLAB_AUTH_FAIL}" == "1" ]]; then
  echo "error: token has expired" >&2
  exit 1
fi

args="$*"

if [[ "$args" == *"mr list"*"--not-draft"* ]]; then
  cat "$FIXTURE_DIR/${FIXTURE_SET}/non_draft_mrs.json"
elif [[ "$args" == *"mr list"*"--draft"* ]]; then
  cat "$FIXTURE_DIR/${FIXTURE_SET}/draft_mrs.json"
elif [[ "$args" == *"mr list"*"sandcastle"* ]]; then
  cat "$FIXTURE_DIR/${FIXTURE_SET}/sandcastle_mrs.json"
elif [[ "$args" == *"api"*"reviewer_username"* ]]; then
  cat "$FIXTURE_DIR/${FIXTURE_SET}/reviewer_mrs.json"
elif [[ "$args" == *"api"*"assignee_username"* ]]; then
  cat "$FIXTURE_DIR/${FIXTURE_SET}/assigned_mrs.json"
elif [[ "$args" == *"issue list"* ]]; then
  # Dead branch kept only so an unrecognized old invocation fails loudly rather than
  # silently — GitLabService no longer fetches issues (see JiraService instead).
  echo "mock glab: 'issue list' is no longer called by triage-cache" >&2
  exit 1
elif [[ "$args" == *"api"*"projects/"* ]]; then
  # Archive-status lookup: glab api "projects/<url-encoded-path>"
  # Decode the path, check it against the fixture's archived-repo list (if any),
  # and return a minimal GitLab Project API response.
  encoded_path=$(echo "$args" | grep -oE 'projects/[^"[:space:]]*' | sed 's|^projects/||')
  decoded_path=$(python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(sys.argv[1]))" "$encoded_path")
  archived_file="$FIXTURE_DIR/${FIXTURE_SET}/archived_projects.json"
  is_archived="false"
  if [[ -f "$archived_file" ]] && python3 -c "
import json, sys
archived = json.load(open('$archived_file'))
sys.exit(0 if '$decoded_path' in archived else 1)
" 2>/dev/null; then
    is_archived="true"
  fi
  printf '{"path_with_namespace": "%s", "archived": %s}\n' "$decoded_path" "$is_archived"
elif [[ "$args" == *"auth status"* ]]; then
  echo "Logged in as testuser"
else
  echo "mock glab: unknown command: $args" >&2
  exit 1
fi
